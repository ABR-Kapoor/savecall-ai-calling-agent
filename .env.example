# ==============================================================================
# InsurCall - Environment Configuration Template
# ==============================================================================

# Clerk Authentication (https://clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_key
CLERK_SECRET_KEY=sk_test_placeholder_secret

# Database & InsForge (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/insforge?sslmode=require
INSFORGE_PROJECT_ID=placeholder_project_id
INSFORGE_API_KEY=ik_placeholder_api_key

# LiveKit Real-time Voice (Self-hosted or Cloud)
LIVEKIT_URL=ws://localhost:7880
VITE_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Telephony Webhook & Agent Security
TELEPHONY_SECRET=your_telephony_secret
AGENT_INTERNAL_SECRET=your_agent_internal_secret

# High Speed LLM Inference (Groq Cloud)
GROQ_API_KEY=gsk_placeholder_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Local LLM Fallback (Ollama / vLLM)
LOCAL_LLM_BASE_URL=http://localhost:11434
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_MODE=hybrid

# Speech-to-Text & Text-to-Speech
STT_BASE_URL=http://localhost:9000/v1
STT_MODEL=Systran/faster-whisper-medium
TTS_BASE_URL=http://localhost:8888
TTS_MODEL=en_US-lessac-medium
TTS_VOICE=en-IN-NeerjaNeural

# OpenWA WhatsApp Gateway (Upstream rmyndharis/OpenWA v0.25.0)
OPENWA_BASE_URL=http://127.0.0.1:2785
OPENWA_API_KEY=your_openwa_admin_secret
WHATSAPP_WEBHOOK_SECRET=your_whatsapp_webhook_hmac_secret
